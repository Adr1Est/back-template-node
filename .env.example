NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# "*" o lista separada por comas: http://localhost:5173,https://app.example.com
CORS_ORIGIN=*
# Swagger UI en /docs (true/false). Sin definir: activo salvo con NODE_ENV=production
# API_DOCS=true

DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public

# Mínimo 32 caracteres. Genera uno con: node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
