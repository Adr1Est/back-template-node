generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Cambia el provider (y el adapter en src/shared/infrastructure/persistence/prisma.ts)
// si el proyecto usa otra base de datos.
datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}
